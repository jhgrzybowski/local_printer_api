# Example environment configuration for local-printer-api
# Copy to .env and customize for your deployment

# Printer settings
QUEUE_NAME=Canon_MG5350
PRINTER_IP=192.168.100.100

# Docker Compose published address and port (not read by the API process)
BACKEND_HOST=192.168.100.99
BACKEND_PORT=8000

# Storage and preview
TMP_DIR=/var/tmp/printer-backend
MAX_UPLOAD_MB=50
PREVIEW_DPI=110

# CORS policy - browser origins allowed to access this API
# Format: comma-separated list of http(s)://host:port
# For local network only. Private IP ranges (RFC 1918) and .local domains are safe to hardcode
# in public repositories. Override here for different deployments.
#
# The default list is defined only in app/settings.py (DEFAULT_CORS_ALLOWED_ORIGINS).
# localhost/127.0.0.1 are excluded: with a LAN-hosted API, SameSite=Lax session
# cookies are not sent from a localhost frontend on cross-site fetch requests.
#
# Example for a different LAN setup (an override replaces the entire default list):
# CORS_ALLOWED_ORIGINS=http://192.168.1.10:8000,http://192.168.1.10:5173

# Leave unset to use the defaults from app/settings.py.
