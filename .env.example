# Example environment configuration for local-printer-api
# Copy to .env and customize for your deployment

# Printer settings
QUEUE_NAME=Canon_MG5350
PRINTER_IP=192.168.100.100
BACKEND_HOST=192.168.100.99
BACKEND_PORT=8000

# Storage and preview
TMP_DIR=/var/tmp/printer-backend
MAX_UPLOAD_MB=50
PREVIEW_DPI=110

# CORS policy - browser origins allowed to access this API
# Format: comma-separated list of http(s)://host:port
# For local network only. Private IP ranges (RFC 1918) and .local domains are safe to hardcode
# in public repositories. Override here for different deployments.
#
# Default includes: 192.168.100.99:8000, ubuntu26-remote.local:8000, drukarka.local:8000,
# plus Vite dev ports (5173-5175) on all hosts and localhost for local development
#
# Example for different setup:
# CORS_ALLOWED_ORIGINS=http://192.168.1.10:8000,http://myhost.local:8000,http://localhost:5173

# Uncomment to customize (leave blank to use defaults from app/settings.py)
# CORS_ALLOWED_ORIGINS=http://192.168.100.99:8000,http://ubuntu26-remote.local:8000,http://drukarka.local:8000
